# Copy to .env and adjust as needed. All have sensible defaults if unset.

STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ar

STT_MIN_AUDIO_SECONDS=0.4
STT_MAX_UPLOAD_MB=15
STT_VAD_MIN_SILENCE_MS=1500
STT_MAX_CONCURRENT=1

STT_ALLOWED_ORIGINS=http://localhost:5173

STT_REQUIRE_API_KEY=false
STT_API_KEY=

STT_LOG_LEVEL=INFO

TTS_SPACE_ID=omarelshehy/NAMAA-Egyptian-Voice
TTS_DEFAULT_REFERENCE_AUDIO=
TTS_EXAGGERATION=0.5
TTS_TEMPERATURE=0.8
TTS_CFGW=0.5
